# ML artifacts — too large for git (209MB total: 45MB optimizer states,
# 22MB adapter safetensors, 17MB tokenizers). Trained adapters are
# reproducible via `python -m ml.train.train_journal`; training data is
# regenerable via `python -m ml.train.prepare_journal_data` from the
# DVC-tracked sources in ml/data/.
ml/train/adapters/
ml/train/data/

# MLflow local tracking store + logged model artifacts (includes copies of the
# adapter weights per run — regenerable by re-running train/eval, same reason
# as the ML artifacts above).
mlflow.db
mlruns/
mlartifacts/

# GGUF quantized model files — large binaries, regenerable via
# ml/serve_gguf/merge_adapter.py + quantize_gguf.py. ft-jrn-merged/ is already
# covered by ml/train/adapters/ above.
ml/serve_gguf/gguf_out/
