{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "intent": {
            "type": "string",
            "enum": [
              "FINANCE_LOG",
              "FINANCE_QUERY",
              "MOOD_CHECKIN",
              "JOURNAL_FREE",
              "SMALLTALK",
              "UNKNOWN"
            ]
          }
        },
        "required": ["text", "intent"]
      }
    }
  },
  "required": ["examples"]
}
