{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "amount_minor": {
            "anyOf": [
              {"type": "integer"},
              {"type": "null"}
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "GROCERIES", "DINING", "FOOD_DELIVERY", "TRANSPORT", "FUEL", "RENT",
                  "UTILITIES", "MOBILE_INTERNET", "SUBSCRIPTIONS", "SHOPPING", "HEALTH",
                  "FITNESS", "EDUCATION", "ENTERTAINMENT", "TRAVEL", "GIFTS", "INSURANCE",
                  "SAVINGS_INVESTMENT", "OTHER"
                ]
              },
              {"type": "null"}
            ]
          },
          "merchant": {
            "anyOf": [
              {"type": "string"},
              {"type": "null"}
            ]
          }
        },
        "required": ["text", "amount_minor", "category", "merchant"]
      }
    }
  },
  "required": ["examples"]
}
